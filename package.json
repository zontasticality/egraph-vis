		"fast-check": "^4.10.2",
		"jsdom": "^27.2.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"elkjs": "^0.11.0",
		"paneforge": "^1.0.2"
	}
